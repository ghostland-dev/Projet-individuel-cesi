@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
 
<main id="main">
    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container-fluid p-0">

            <div class="d-flex justify-content-between align-items-center px-2">
                <h2>Contact</h2>
                <ol>
                    <li><a href="index.html">Accueil</a></li>
                    <li>Connexion</li>
                </ol>
            </div>

        </div>
    </section><!-- End Breadcrumbs -->

    <section id="contact" class="contact">
        <div class="container">
            <div class="row card p-3 justify-content-center" data-aos="fade-up">
                <div class="col-lg-4">
            <form id="account" method="post">
                <h2 class="text-center"> Portail de connexion</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-green" >Se connecter</button>
                </div>
                <div>
                    <p>
                        <a  class="text-success " id="forgot-password" asp-page="./ForgotPassword">Mot de passe oublié ?</a>
                    </p>
                    <p>
                        <a  class="text-success " asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"> S'inscrire</a>
                    </p>
                    <p>
                        <a class="text-success "  id="resend-confirmation" asp-page="./ResendEmailConfirmation">Renvoyez le mail de confirmation </a>
                    </p>
                </div>
            </form>
                </div>

            </div>

        </div>
    </section><!-- End Contact Section -->

</main><!-- End #main -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
