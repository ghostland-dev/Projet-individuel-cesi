@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model IEnumerable<Alimbio.Models.Entreprise>

@{
    ViewData["Title"] = "Index";
}



<main id="main">

    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">

            @if (SignInManager.IsSignedIn(User))
            {
                <a class="btn btn-green" asp-action="Create"> <i class="bi bi-plus"> nouvelle entreprise </i></a>
            }

            <div class="d-flex justify-content-between align-items-center">
                <h2>Entreprise</h2>
                <ol>
                    <li><a href="#">Entreprises</a></li>
                    <li><a href="#">Entreprise/details</a></li>
                    <li>Details de service </li>
                </ol>
            </div>

        </div>
    </section><!-- End Breadcrumbs -->
    <!-- ======= Portfolio Details Section ======= -->
    <section id="portfolio-details" class="portfolio-details">
        <div class="container" data-aos="fade-up">

            <div class="row gy-4">

                @foreach (var item in Model) {

                <div class="col-lg-6">
                    <div class="portfolio-info">
                        <h3>Information - Entreprise (@Html.DisplayFor(model =>item.Nic ))  </h3>
                        <ul>
                            <li><strong>Nom</strong>:  @Html.DisplayFor(model => item.SiretFormatSiege)</li>
                            <li><strong>Prénom</strong>:  @Html.DisplayFor(model => item.SiretSiege)</li>
                            <li><strong>E-mail</strong>:  @Html.DisplayFor(model => item.Siren)</li>
                            <li><strong>Mobile</strong>:  @Html.DisplayFor(model => item.SiteWeb)</li>


                        </ul>
                        <ul>
                            <li>
                            
                                    <a class="btn btn-green" asp-action="Details" asp-route-id="@item?.Id"><i class="fas fa-eye text-white"></i></a>
                                @if (SignInManager.IsSignedIn(User))
                                {
                                    <a class="btn btn-orange" asp-action="Edit" asp-route-id="@item?.Id"><i class="fas fa-pen text-white"></i></a>
                                    <a class="btn btn-red" asp-action="delete" asp-route-id="@item?.Id"><i class="fas fa-trash text-white"></i></a>
                                }
                            </li>

                        </ul>
                    </div>
                </div>
 

                }

            </div>


        </div>
    </section><!-- End   Details Section -->

</main><!-- End #main -->

 