@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model Alimbio.Models.Entreprise

@{
    ViewData["Title"] = "Details";
}

<main id="main">

    <!-- ======= Breadcrumbs ======= -->
    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">

            <div class="d-flex justify-content-between align-items-center">
                <h2>Entreprise</h2>
                <ol>
                    <li><a href="#">Entreprises</a></li>
                    <li><a href="#">Entreprise/details</a></li>
                    <li>Details de service </li>
                </ol>
            </div>

        </div>
    </section><!-- End Breadcrumbs -->
    <!-- ======= Portfolio Details Section ======= -->
    <section id="portfolio-details" class="portfolio-details">
        <div class="container" data-aos="fade-up">

            <div class="row gy-4">



                <div class="col-lg-6">
                    <div class="portfolio-info">
                        <h3>Information - Entreprise (@Html.DisplayFor(model => model.NomEntreprise))  </h3>
                        <ul>
                            <li><strong>Nom</strong>:  @Html.DisplayFor(model => model.SiretFormatSiege)</li>
                            <li><strong>Prénom</strong>:  @Html.DisplayFor(model => model.SiretSiege)</li>
                            <li><strong>E-mail</strong>:  @Html.DisplayFor(model => model.Siren)</li>
                            <li><strong>Mobile</strong>:  @Html.DisplayFor(model => model.SiteWeb)</li>
                          
                           
                        </ul>
                        <ul>
                            <li>
                                <a class="btn btn-green" asp-action="Index"><i class="fas fa-arrow-left"></i></a>

                                @if (SignInManager.IsSignedIn(User))
                                {
                                    <a class="btn btn-orange" asp-action="Edit" asp-route-id="@Model?.Id"><i class="fas fa-pen text-white"></i></a>
                                    <a class="btn btn-red" asp-action="delete" asp-route-id="@Model?.Id"><i class="fas fa-trash text-white"></i></a>
                                }
                            </li>

                        </ul>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="portfolio-info">
                        <h3>Information - Site </h3>
                        <ul>

                            <li><strong>Nom de Site</strong>: @Html.DisplayFor(model => model.Capital) || <strong>SIREN</strong>: @Html.DisplayFor(model => model.Nic)</li>
                             


                        </ul>
                    </div>
                </div>
                <div class="col-lg-12 card py-2">
                    <div class="portfolio-description">
                        <h3>Information - Service </h3>
                        <ul>
                            <li><strong>Nom de service</strong>:  @Html.DisplayFor(model => model.AdresseComplet)</li>
                            <strong>Description</strong>:
                            <p> @Html.DisplayFor(model => model.Capital)</p>

                        </ul>
                    </div>
                </div>




            </div>


        </div>
    </section><!-- End   Details Section -->

</main><!-- End #main -->




 